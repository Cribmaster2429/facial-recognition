# Application Settings
APP_NAME=Facial Recognition System
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/faces.db

# Recognition Settings
DETECTION_MODEL=hog
ENCODING_MODEL=large
TOLERANCE=0.6
MIN_FACE_SIZE=20

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
